#!/bin/bash
# Provision one normal administrator during the first interactive root login.
set -euo pipefail

STATE_DIR=/var/lib/quark-first-login
FLAG=$STATE_DIR/done

[ "$(id -u)" -eq 0 ] || { echo "must run as root" >&2; exit 1; }
[ -e "$FLAG" ] && exec /bin/bash -l
[ -t 0 ] && [ -t 1 ] || {
	echo "First-login provisioning requires an interactive serial or SSH login." >&2
	exit 1
}

echo "Quark-N first-login setup"
echo "Create the normal account used for day-to-day login."

while :; do
	read -r -p 'New username: ' USERNAME
	case "$USERNAME" in
		root|alarm|'') echo "Choose a non-reserved, non-empty username." ;;
		*[!a-z0-9_-]*|[!a-z_]* ) echo "Use lowercase letters, digits, _ or -; start with a letter or _." ;;
		*)
			if getent passwd "$USERNAME" >/dev/null; then
				echo "That account already exists."
			else
				break
			fi
			;;
	esac
done

useradd -m -s /bin/bash -G wheel,audio,video,input "$USERNAME"
echo "Set the password for $USERNAME:"
passwd "$USERNAME"

install -d -o root -g root -m 0755 "$STATE_DIR"
# Never call `passwd root` here. The new account password must be independent
# from root, and root SSH remains enabled by the image policy.
usermod -s /bin/bash root
touch "$FLAG"

echo "Provisioning complete. Use $USERNAME for daily work; root SSH remains enabled."
exec su - "$USERNAME"
