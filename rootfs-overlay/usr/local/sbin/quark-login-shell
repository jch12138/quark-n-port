#!/bin/bash
# Root's release-image login shell.  Refuse non-interactive root commands
# until first-login provisioning has completed, then become normal bash.
set -euo pipefail

FLAG=/var/lib/quark-first-login/done

if [ -e "$FLAG" ]; then
	exec /bin/bash "$@"
fi

if [ "$#" -ne 0 ]; then
	echo "Quark-N first-login provisioning is required before root commands are allowed." >&2
	exit 1
fi

exec /usr/local/sbin/quark-first-login
