index 000000000..edb0fad21
--- /dev/null
+++ b/arch/arm/boot/dts/allwinner/sun8i-h3-quark-n.dts
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device tree for the Pengzhihui (Seeed) Quark-N SoM on the Atom-N carrier,
+ * i.e. the "Quantum Mini Linux Development Kit".
+ *
+ * Pin mapping derived from the vendor kernel device tree
+ * (sun8i-h3-atom_n.dtb) shipped with the factory image, re-expressed in
+ * modern mainline syntax.
+ *
+ * SoC:  Allwinner H3 (sun8i-h3), quad Cortex-A7
+ * RAM:  512MB DDR3 @ 408MHz
+ * eMMC: 16GB (mmc2, 8-bit)
+ */
+#include "sun8i-h3-nanopi.dtsi"
+
+/ {
+	model = "Pengzhihui Quark-N (Quantum Mini Linux Development Kit)";
+	compatible = "friendlyelec,nanopi-neo-core", "allwinner,sun8i-h3";
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &mmc0;
+		mmc2 = &mmc2;
+	};
+
+	/*
+	 * Power rails. These are controlled by GPIOs on the SoM (r_pio / PL).
+	 * U-Boot SPL already brings them up; the kernel just needs to know
+	 * they exist and leave them alone (always-on / boot-on).
+	 */
+
+	/* CPU core voltage, switched between 1.1V and 1.3V via PL6 */
+	vdd_cpux: vdd-cpux {
+		compatible = "regulator-gpio";
+		regulator-name = "vdd-cpux";
+		regulator-type = "voltage";
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1300000>;
+		regulator-ramp-delay = <50>;
+		gpios = <&r_pio 0 6 GPIO_ACTIVE_HIGH>;
+		gpios-states = <1>;
+		states = <1100000 0x0>, <1300000 0x1>;
+	};
+
+	/* 1.2V rail (PL8) */
+	reg_vcc1v2: vcc1v2 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc1v2";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&reg_vcc5v0>;
+		gpio = <&r_pio 0 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/* DRAM 1.5V rail (PL9) */
+	reg_vcc_dram: vcc-dram {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-dram";
+		regulator-min-microvolt = <1500000>;
+		regulator-max-microvolt = <1500000>;
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&reg_vcc5v0>;
+		gpio = <&r_pio 0 9 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/* USB OTG VBUS (PL2) */
+	reg_usb0_vbus: usb0-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb0-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+		gpio = <&r_pio 0 2 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+/* eMMC on mmc2 (8-bit) */
+&mmc2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc2_8bit_pins>;
+	vmmc-supply = <&reg_vcc3v3>;
+	bus-width = <8>;
+	non-removable;
+	cap-mmc-hw-reset;
+	status = "okay";
+};
+
+&mmc2_8bit_pins {
+	/* Increase drive strength for DDR modes */
+	drive-strength = <40>;
+	/* eMMC is missing pull-ups */
+	bias-pull-up;
+};
+
+/* USB host ports + OTG (Atom-N: 2x USB-A + 1x USB-C, RTL8723BU on USB) */
+&ehci0 {
+	status = "okay";
+};
+
+&ehci1 {
+	status = "okay";
+};
+
+&ehci2 {
+	status = "okay";
+};
+
+&ohci0 {
+	status = "okay";
+};
+
+&ohci1 {
+	status = "okay";
+};
+
+&ohci2 {
+	status = "okay";
+};
+
+&usb_otg {
+	status = "okay";
+	dr_mode = "otg";
+};
+
+&usbphy {
+	/* Atom-N schematic and factory DT route USB0 ID to PG12. */
+	usb0_id_det-gpios = <&pio 6 12 GPIO_ACTIVE_HIGH>;
+	usb0_vbus-supply = <&reg_usb0_vbus>;
+};
+
+/* VDD1V2-SYS powers the Mali domain on the Quark-N SoM. */
+&mali {
+	mali-supply = <&reg_vcc1v2>;
+};
+
+/* SPI0: Atom-N onboard 1.14-inch ST7789VW (240x135) */
+&spi0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0_pins>;
+
+	/*
+	 * Preset the SPI module clock from pll-periph0 at probe time so the
+	 * driver never has to reparent it at runtime (the runtime clk_set_rate
+	 * reparent was leaving SCLK dead -> every transfer timed out with -110).
+	 */
+	assigned-clocks = <&ccu CLK_SPI0>;
+	assigned-clock-parents = <&ccu CLK_PLL_PERIPH0>;
+	assigned-clock-rates = <100000000>;
+
+	/*
+	 * Drop the DMA channels: the sun6i SPI DMA path hangs on the large
+	 * fbcon pixel blits and takes the kernel down with it (LCD black +
+	 * serial console unresponsive). PIO is plenty for a 240x135 console.
+	 */
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+
+	display@0 {
+		/*
+		 * panel-mipi-dbi-spi (8-bit SPI + separate DC line), NOT
+		 * panel-sitronix-st7789v: that driver hardcodes 9-bit SPI
+		 * (spi->bits_per_word = 9) which sun6i SPI cannot do, and its
+		 * pixel path is DPI/RGB. The compatible also names the firmware
+		 * file seeed,quark-n-st7789v.bin (already built in via
+		 * CONFIG_EXTRA_FIRMWARE).
+		 *
+		 * The factory fbtft registration leaves chip_select at its
+		 * default 0, which is the native SPI0 CS0 pin PC3.
+		 */
+		compatible = "seeed,quark-n-st7789v", "panel-mipi-dbi-spi";
+		reg = <0>;
+		/* Start conservatively; raise toward 15 MHz after board validation. */
+		spi-max-frequency = <8000000>;
+		spi-cpol;
+		spi-cpha;
+		dc-gpios = <&pio 0 0 GPIO_ACTIVE_HIGH>;    /* PA0 */
+		reset-gpios = <&pio 0 1 GPIO_ACTIVE_HIGH>; /* PA1 */
+		write-only;
+
+		/* Physical size only feeds DPI; harmless if approximate. */
+		width-mm = <25>;
+		height-mm = <14>;
+
+		panel-timing {
+			hactive = <240>;
+			vactive = <135>;
+			/* Native RAM window starts at column 40, row 53. */
+			hback-porch = <40>;
+			vback-porch = <53>;
+			clock-frequency = <0>;
+			hfront-porch = <0>;
+			hsync-len = <0>;
+			vfront-porch = <0>;
+			vsync-len = <0>;
+		};
+	};
+};
+
+/* Onboard audio codec: mic on MIC1, line out on LINEOUT */
+&codec {
+	allwinner,audio-routing =
+		"Line Out", "LINEOUT",
+		"MIC1", "Mic",
+		"Mic", "MBIAS";
+	status = "okay";
+};
+
+&codec_analog {
+	status = "okay";
+};
+
+/* Atom-N schematic: MPU_SCL/SDA are Quark-N I2C0 (PA11/PA12). */
+&i2c0 {
+	clock-frequency = <100000>;
+	status = "okay";
+
+	mpu6050: imu@68 {
+		compatible = "invensense,mpu6050";
+		reg = <0x68>;
+		vdd-supply = <&reg_vcc3v3>;
+		vddio-supply = <&reg_vcc3v3>;
+	};
+};
+
+&i2c1 {
+	status = "okay";
+};
+
+&i2c2 {
+	status = "okay";
+};
+
+/*
+ * TODO items to resolve with hardware in hand:
+ *  - MPU6050 does not ACK on the currently running board even though the
+ *    schematic confirms I2C0; re-test after a full power cycle and inspect
+ *    population/pull-ups if it still times out.
+ *  - GPIO-KEY is PL3 according to the Atom-N schematic; verify button events.
+ *  - Ethernet (EMAC): vendor DT has it disabled; Atom-N likely has no PHY.
+ */
diff --git a/firmware/seeed,quark-n-st7789v.bin b/firmware/seeed,quark-n-st7789v.bin
new file mode 100644
